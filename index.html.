<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body style="background:#000;color:#fff;margin:0;display:flex;flex-direction:column;height:100vh;font-family:sans-serif">
<div id="chat" style="flex:1;padding:15px;overflow:auto"></div>
<div style="display:flex;padding:10px;background:#111">
<input id="inp" placeholder="Message likh..." style="flex:1;padding:12px;border-radius:20px;border:0;background:#222;color:#fff">
<button onclick="send()" style="margin-left:8px;padding:12px 20px;border-radius:20px;border:0;background:#fff;font-weight:bold">Bhej</button>
</div>
<script>
const supa=supabase.createClient("https://lupdgnuenlwkacrpndqm.supabase.co","sb_publishable_jb96cnbFDHDaK-2PxJ3BRg_plxW4MRV");
async function load(){let{data}=await supa.from('chats').select('*').order('id');let d=document.getElementById('chat');d.innerHTML="";data.forEach(c=>d.innerHTML+=`<div style="background:#222;padding:10px;border-radius:10px;margin:8px 0">${c.msg}</div>`)}
async function send(){let i=document.getElementById('inp');if(!i.value)return;await supa.from('chats').insert({msg:i.value});i.value="";load()}
supa.channel('c').on('postgres_changes',{event:'INSERT',schema:'public',table:'chats'},load).subscribe();load();
</script>
</body>
</html>
